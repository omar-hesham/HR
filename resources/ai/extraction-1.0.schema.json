{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "contacts",
    "city",
    "governorate",
    "education",
    "experience_total_years",
    "experience_relevant_years",
    "previous_roles",
    "skills",
    "certifications",
    "languages",
    "military_status",
    "shift_availability",
    "expected_salary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "name": {
      "$ref": "#/$defs/stringFact"
    },
    "contacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email",
        "phone"
      ],
      "properties": {
        "email": {
          "$ref": "#/$defs/stringFact"
        },
        "phone": {
          "$ref": "#/$defs/stringFact"
        }
      }
    },
    "city": {
      "type": "null"
    },
    "governorate": {
      "type": "null"
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "field"
        ],
        "properties": {
          "level": {
            "$ref": "#/$defs/stringFact"
          },
          "field": {
            "$ref": "#/$defs/stringFact"
          }
        }
      }
    },
    "experience_total_years": {
      "$ref": "#/$defs/numberFact"
    },
    "experience_relevant_years": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job_id",
          "years"
        ],
        "properties": {
          "job_id": {
            "type": "string"
          },
          "years": {
            "$ref": "#/$defs/numberFact"
          }
        }
      }
    },
    "previous_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "employer",
          "start_date",
          "end_date"
        ],
        "properties": {
          "title": {
            "$ref": "#/$defs/stringFact"
          },
          "employer": {
            "$ref": "#/$defs/stringFact"
          },
          "start_date": {
            "$ref": "#/$defs/stringFact"
          },
          "end_date": {
            "$ref": "#/$defs/stringFact"
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stringFact"
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stringFact"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stringFact"
      }
    },
    "military_status": {
      "$ref": "#/$defs/stringFact"
    },
    "shift_availability": {
      "$ref": "#/$defs/stringFact"
    },
    "expected_salary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency",
        "period"
      ],
      "properties": {
        "amount": {
          "$ref": "#/$defs/numberFact"
        },
        "currency": {
          "$ref": "#/$defs/stringFact"
        },
        "period": {
          "$ref": "#/$defs/stringFact"
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote"
      ],
      "properties": {
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "evidence",
        "confidence"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "stringFact": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "numberFact": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      ]
    }
  }
}
