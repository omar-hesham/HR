# Recruitment Screening Tool — environment template. NO SECRETS in this file.
# Copy to .env, then: php artisan key:generate && php artisan recruit:key

APP_NAME="Recruitment Screening"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_DEMO_BANNER=false
APP_URL=http://localhost:8000
# Storage timezone is always UTC (config/app.php); display timezone below.
APP_DISPLAY_TIMEZONE=Africa/Cairo
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local/tests: sqlite. Production: mysql 8.4 LTS, utf8mb4 / utf8mb4_0900_ai_ci.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=recruitment
# DB_USERNAME=recruitment
# DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

# M9-P0-04: 30-minute idle timeout; database driver so revoked users can be signed out.
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true in production (HTTPS only)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Database queue + Supervisor in production; no Redis/Horizon.
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=600
CACHE_STORE=database

# Outbound mail for the privacy notice (Milestone 2); separate from the intake mailbox.
MAIL_MAILER=log
MAIL_SEND_TRANSPORT=array
# Set transport to notice and supply these only for approved delivery.
MAIL_SEND_SCHEME=smtps
MAIL_SEND_HOST=
MAIL_SEND_PORT=465
MAIL_SEND_USERNAME=
MAIL_SEND_PASSWORD=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="jobs@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Content encryption (SEC-P0-02): separate from APP_KEY. Generate: php artisan recruit:key
FILE_ENCRYPTION_KEY=
# HMAC key for contact matching (Milestone 3)
DEDUP_HMAC_KEY=

# --- Text extraction (M2-P0-03)
PDFTOTEXT_PATH=pdftotext
PDFTOTEXT_TIMEOUT=60
DOC_CONVERSION_ENABLED=false
LIBREOFFICE_PATH=soffice
LIBREOFFICE_TIMEOUT=60

# --- Text quality thresholds (M2-P0-04) — defaults; editable in Settings
TEXT_MIN_LETTER_RATIO=0.60
TEXT_MIN_WORDLIST_RATIO=0.40
TEXT_MAX_REVERSED_RATIO=0.20
TEXT_MIN_LETTERS=40

# --- Upload limits (M2-P0-02) — defaults; editable in Settings
UPLOAD_MAX_FILE_MB=10
UPLOAD_MAX_BATCH_FILES=50
UPLOAD_MAX_BATCHES_PER_HOUR=10

# --- Retention (PRIV-P0-03) — placeholders until the factory approves (Q05); editable in Settings
RETENTION_DAYS=365
RETENTION_IDLE_DAYS=180
RETENTION_HARD_MAX_DAYS=730
RETENTION_OWNER_NOTICE_DAYS=14
RETENTION_HIRED_HANDOVER_DAYS=30
KEEP_ID_CARD_ATTACHMENTS=false

# --- Mailbox intake (Milestone 2). Secrets only here, never in the database.
MAILBOX_PROVIDER=
MAILBOX_ADDRESS=
MAILBOX_HOST=
MAILBOX_PORT=993
MAILBOX_TLS=true
MAILBOX_USERNAME=
MAILBOX_PASSWORD=
MAILBOX_TENANT_ID=
MAILBOX_CLIENT_ID=
MAILBOX_CLIENT_SECRET=
MAILBOX_REFRESH_TOKEN=
MAILBOX_START_AT=
MAILBOX_FOLDER=INBOX
MAILBOX_FAKE_PATH=

# --- Mail intake (Milestone 2)
# Scanner: clamav (needs a reachable clamd socket) or null (skip, local dev only).
MALWARE_SCANNER=null
CLAMAV_SOCKET=unix:///var/run/clamav/clamd.ctl
CLAMAV_TIMEOUT=30
INTAKE_MAX_MESSAGES_PER_POLL=100
INTAKE_MAX_ATTACHMENT_MB=25
INTAKE_SILENCE_ALERT_HOURS=48
INTAKE_PRIVACY_NOTICE_RESEND_DAYS=30
PRIVACY_NOTICE_VERSION=1
# Notice + alert mail transport (separate from intake credentials, spec 5.3).
MAIL_SEND_TRANSPORT=array
# Set transport to notice and supply these only for approved delivery.
MAIL_SEND_SCHEME=smtps
MAIL_SEND_HOST=
MAIL_SEND_PORT=465
MAIL_SEND_USERNAME=
MAIL_SEND_PASSWORD=
# Pseudonymous sender de-duplication key: php artisan recruit:key
DEDUP_HMAC_KEY=

# --- AI engine (Milestone 3). Cloud only after masking + written legal approval.

# --- Backups and alerts (Milestone 4)
BACKUP_TARGET=
BACKUP_ENCRYPTION_KEY=
HEALTH_ALERT_RECIPIENT=

# --- Local/testing only: password for the synthetic demo accounts (DemoUsersSeeder)
SEED_USER_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# M3: disabled until approved. Never fail over automatically.
AI_DRIVER=fake
AI_PIPELINE_ENABLED=false
AI_BASE_URL=http://127.0.0.1:8080/v1
AI_API_KEY=
AI_MODEL=local-model
AI_TIMEOUT_SECONDS=600
AI_CLOUD_BASE_URL=
AI_CLOUD_API_KEY=
AI_CLOUD_MODEL=
AI_MONTHLY_CAP_EGP=300
AI_LEGAL_APPROVAL_REF=
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_RECOVERY_SECONDS=60

# M4b: approved Egyptian mounted destination; keys provisioned separately, never archived.
BACKUP_TARGET=
BACKUP_ENCRYPTION_KEY=
DELETION_LEDGER_TARGET=
# Dedicated EMPTY isolated MySQL database and account (no grants on the live database).
RESTORE_DB_HOST=127.0.0.1
RESTORE_DB_PORT=3306
RESTORE_DB_DATABASE=
RESTORE_DB_USERNAME=
RESTORE_DB_PASSWORD=
