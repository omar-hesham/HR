{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "omarhesham/recruit-app",
    "type": "project",
    "description": "Recruitment screening tool (Phase 1) - single-tenant, Arabic-first.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "giggsey/libphonenumber-for-php": "^9.0",
        "laravel/ai": "^1.2",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "opis/json-schema": "^2.6",
        "phpoffice/phpspreadsheet": "^5.10",
        "phpoffice/phpword": "^1.4",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-permission": "^8.3",
        "spatie/pdf-to-text": "^1.55",
        "webklex/php-imap": "^6.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "mpdf/mpdf": "^8.3",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan recruit:key",
            "@php artisan migrate --seed --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": [
            "vendor/bin/pint --test"
        ],
        "lint:fix": [
            "vendor/bin/pint"
        ],
        "stan": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpstan analyse --memory-limit=1G --no-progress"
        ],
        "gates": [
            "Composer\\Config::disableProcessTimeout",
            "@lint",
            "@stan",
            "@test"
        ],
        "fixtures": [
            "@php tests/Fixtures/generate.php"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
